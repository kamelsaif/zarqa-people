const CONFIG={WORKSPACE_DOMAIN:'CHANGE_ME.example',ADMIN_EMAILS:['CHANGE_ME@CHANGE_ME.example'],BACKUP_RETENTION_DAYS:30};
const TABLES={requests:'Requests',shifts:'Shifts',contracts:'Contracts',documents:'EmploymentDocuments',employees:'Employees',attendance:'Attendance',jobs:'Jobs',candidates:'Candidates',leaves:'LeaveRequests',policies:'Policies',payroll:'PayrollRuns',offboarding:'Offboarding',reviews:'Reviews',events:'Events',audit:'Audit'};
function props_(){return PropertiesService.getScriptProperties();}
function book_(){const id=props_().getProperty('SPREADSHEET_ID');if(!id)throw Error('Run setup from the editor first.');return SpreadsheetApp.openById(id);}
function identity_(){const email=Session.getActiveUser().getEmail().toLowerCase();if(!email||email.split('@')[1]!==CONFIG.WORKSPACE_DOMAIN.toLowerCase())throw Error('Google Workspace identity is required. Deploy only within your domain; do not use public anonymous access.');return email;}
function setup(){
 const effective=Session.getEffectiveUser().getEmail().toLowerCase();if(CONFIG.WORKSPACE_DOMAIN.startsWith('CHANGE_ME')||!CONFIG.ADMIN_EMAILS.map(e=>e.toLowerCase()).includes(effective))throw Error('Set CONFIG.WORKSPACE_DOMAIN and CONFIG.ADMIN_EMAILS before setup.');
 if(props_().getProperty('SPREADSHEET_ID'))throw Error('Already configured. Existing data was preserved.');
 const ss=SpreadsheetApp.create('Zarqa People • HR Database');const initialSheet=ss.getSheets()[0];const folder=DriveApp.createFolder('Zarqa People • Private HR');props_().setProperties({SPREADSHEET_ID:ss.getId(),DRIVE_FOLDER_ID:folder.getId(),AUTO_SEND:'false',OWNER_EMAIL:effective});folder.addFile(DriveApp.getFileById(ss.getId()));
 const settings=ss.insertSheet('Settings');settings.appendRow(['key','json']);ss.insertSheet('Roles').appendRow(['email','role']);CONFIG.ADMIN_EMAILS.forEach(e=>ss.getSheetByName('Roles').appendRow([e.toLowerCase(),'admin']));
 Object.keys(TABLES).forEach(k=>ss.insertSheet(TABLES[k]).appendRow(['id','json']));ss.deleteSheet(initialSheet);
 const s=makeSeed();Object.keys(TABLES).filter(k=>k!=='policies').forEach(k=>s[k]=[]);s.access=CONFIG.ADMIN_EMAILS.map(email=>({email:email.toLowerCase(),role:'admin'}));s.settings.autoSend=false;s.revision=0;writeState_(s);backup_(s);console.log('Created private spreadsheet: '+ss.getUrl());console.log('Created private Drive folder. No mail scheduling is enabled.');
}
function readState_(){const ss=book_(),s={schema:1,revision:Number(props_().getProperty('REVISION')||0)};const settings=ss.getSheetByName('Settings').getDataRange().getValues();s.settings=JSON.parse(settings[1][1]);Object.keys(TABLES).forEach(k=>{const sheet=ss.getSheetByName(TABLES[k]);s[k]=sheet?sheet.getDataRange().getValues().slice(1).filter(r=>r[1]).map(r=>JSON.parse(r[1])):[];});s.access=ss.getSheetByName('Roles').getDataRange().getValues().slice(1).filter(r=>r[0]).map(r=>({email:String(r[0]).toLowerCase(),role:String(r[1])}));s.settings.autoSend=props_().getProperty('AUTO_SEND')==='true';return hrEnsureOperations(s);}
function writeRows_(sheet,rows){const last=sheet.getLastRow();if(last>1)sheet.getRange(2,1,last-1,2).clearContent();if(rows.length)sheet.getRange(2,1,rows.length,2).setValues(rows.map(r=>[r[0],r[1]]));}
function writeState_(s){hrEnsureOperations(s);const ss=book_();writeRows_(ss.getSheetByName('Settings'),[['settings',JSON.stringify(s.settings)]]);Object.keys(TABLES).forEach(k=>{let sheet=ss.getSheetByName(TABLES[k]);if(!sheet){sheet=ss.insertSheet(TABLES[k]);sheet.appendRow(['id','json']);}writeRows_(sheet,s[k].map(r=>[String(r.id??''),JSON.stringify(r)]));});if(s.access)writeRows_(ss.getSheetByName('Roles'),s.access.map(r=>[r.email,r.role]));props_().setProperty('REVISION',String(s.revision));SpreadsheetApp.flush();}
function actor_(s){const email=identity_();const roles=book_().getSheetByName('Roles').getDataRange().getValues().slice(1);const row=roles.find(r=>String(r[0]).toLowerCase()===email);const employee=s.employees.find(e=>e.email.toLowerCase()===email);if(employee?.status==='inactive')throw Error('This employee account is inactive.');const role=row?String(row[1]):employee?'employee':'';if(!['admin','hr','finance','manager','employee'].includes(role))throw Error('Your account has not been assigned access.');return{email,role,employeeId:employee?.id||'',demo:false};}
function scopeState_(s,a){const clone=hrEnsureOperations(JSON.parse(JSON.stringify(s)));if(a.role!=='admin')delete clone.access;clone.requests=clone.requests.filter(r=>hrRequestVisible(s,r,a));if(a.role==='finance'){clone.documents=[];clone.contracts=[];clone.candidates=[];clone.audit=[];}if(['admin','hr','finance'].includes(a.role))return clone;const visible=clone.employees.filter(e=>e.id===a.employeeId||a.role==='manager'&&e.manager===a.employeeId),ids=new Set(visible.map(e=>e.id));clone.employees=visible.map(e=>{if(e.id!==a.employeeId){e.salary=0;e.allowance=0;e.bonus=0;e.deduction=0;e.email='';e.acknowledgments=[];}return e;});clone.attendance=clone.attendance.filter(r=>ids.has(r.employeeId));clone.shifts=clone.shifts.filter(r=>ids.has(r.employeeId)&&(a.role!=='employee'||r.status==='published'));clone.contracts=[];clone.leaves=clone.leaves.filter(r=>ids.has(r.employeeId));clone.reviews=clone.reviews.filter(r=>ids.has(r.employeeId));clone.payroll=clone.payroll.filter(r=>r.status!=='draft').map(r=>({...r,rows:r.rows.filter(row=>row.employeeId===a.employeeId)})).filter(r=>r.rows.length);clone.documents=(clone.documents||[]).filter(d=>d.employeeId===a.employeeId);clone.offboarding=[];clone.audit=[];clone.candidates=[];return clone;}
function doGet(){identity_();return HtmlService.createHtmlOutputFromFile('Index').setTitle('Zarqa People').addMetaTag('viewport','width=device-width, initial-scale=1');}
function api(action,payload){
 const lock=LockService.getScriptLock();if(!lock.tryLock(20000))throw Error('Busy. Wait and retry.');try{const s=readState_(),a=actor_(s);if(action==='admin.status')return dataStatus_(s,a);if(action==='admin.backup')return manualBackup_(s,a);if(action==='bootstrap')return {state:scopeState_(s,a),actor:a};if(action==='getState')return scopeState_(s,a);if(action==='uploadDocument'){uploadDocument_(s,payload,a);writeState_(s);backup_(s);return scopeState_(s,a);}if(action==='getDocument'){return getDocument_(s,payload.id,a);}if(action==='mutate'){const p=payload||{};if(p.action==='access.set'&&CONFIG.ADMIN_EMAILS.map(e=>e.toLowerCase()).includes(String(p.payload.email).toLowerCase())&&p.payload.role!=='admin')throw Error('Configured owner admins cannot be demoted.');hrMutate(s,p.action,p.payload||{},a);if(p.action==='settings.save'&&a.role==='admin'){setSchedule_(!!p.payload.autoSend);s.settings.autoSend=props_().getProperty('AUTO_SEND')==='true';}writeState_(s);backup_(s);return scopeState_(s,a);}if(action==='sendPayroll'){if(!['admin','finance'].includes(a.role))throw Error('Finance access required');const result=sendPayroll_(s,payload.id,a.email);writeState_(s);return result;}throw Error('Unknown API action');}finally{lock.releaseLock();}
}
function backup_(s,force){
 const now=new Date(),today=Utilities.formatDate(now,'Africa/Cairo','yyyy-MM-dd');
 if(!force&&props_().getProperty('BACKUP_DATE')===today)return;
 const name='backup-'+today+(force?'-manual-'+Utilities.getUuid():'')+'.json';
 const file=DriveApp.getFolderById(props_().getProperty('DRIVE_FOLDER_ID')).createFile(name,JSON.stringify(s),MimeType.PLAIN_TEXT);
 props_().setProperties({BACKUP_DATE:today,BACKUP_AT:now.toISOString(),BACKUP_FILE_ID:file.getId()});
 return {fileId:file.getId(),createdAt:now.toISOString()};
}
function requireDataAdmin_(a){if(a.role!=='admin')throw Error('Administrator access required.');}
function dataStatus_(s,a){
 requireDataAdmin_(a);
 const ss=book_(),folder=DriveApp.getFolderById(props_().getProperty('DRIVE_FOLDER_ID'));
 if(folder.isTrashed()||DriveApp.getFileById(ss.getId()).isTrashed())throw Error('Configured storage is in the trash. Ask the company administrator to restore it.');
 return {connected:true,checkedAt:new Date().toISOString(),domain:CONFIG.WORKSPACE_DOMAIN,databaseName:ss.getName(),archiveName:folder.getName(),lastBackupAt:props_().getProperty('BACKUP_AT')||'',lastBackupDate:props_().getProperty('BACKUP_DATE')||'',records:Object.fromEntries(Object.keys(TABLES).map(k=>[k,(s[k]||[]).length]))};
}
function manualBackup_(s,a){
 requireDataAdmin_(a);
 // Check both configured resources before attempting a snapshot. Never accept IDs from the browser.
 dataStatus_(s,a);
 backup_(s,true);
 s.audit.unshift({id:'A-'+Utilities.getUuid(),at:new Date().toISOString(),actor:a.email,action:'data.backup: manual private Drive snapshot'});
 s.revision++;writeState_(s);
 return dataStatus_(s,a);
}
function enablePayrollSchedule(){const s=readState_(),a=actor_(s);if(a.role!=='admin'||a.email!==props_().getProperty('OWNER_EMAIL'))throw Error('Only the configured owner can install the mail trigger.');ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='payrollTick').forEach(t=>ScriptApp.deleteTrigger(t));ScriptApp.newTrigger('payrollTick').timeBased().everyDays(1).atHour(9).inTimezone('Africa/Cairo').create();props_().setProperty('AUTO_SEND','true');}
function disablePayrollSchedule(){const a=actor_(readState_());if(a.role!=='admin')throw Error('Admin required');props_().setProperty('AUTO_SEND','false');ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='payrollTick').forEach(t=>ScriptApp.deleteTrigger(t));}
function payrollTick(){if(props_().getProperty('AUTO_SEND')!=='true')return;const lock=LockService.getScriptLock();if(!lock.tryLock(1000))return;try{const s=readState_(),date=Utilities.formatDate(new Date(),'Africa/Cairo','yyyy-MM-dd'),month=date.slice(0,7),day=Number(date.slice(-2));if(day<s.settings.payday)return;const run=s.payroll.find(r=>r.month===month&&r.status==='approved');if(!run)return;sendPayroll_(s,run.id,'scheduled-owner-trigger');writeState_(s);}finally{lock.releaseLock();}}
function sendPayroll_(s,id,actor){
 const run=s.payroll.find(r=>r.id===id);if(!run||!['approved','sent'].includes(run.status))throw Error('Approve this payroll before sending.');if(!run.approvedBy)throw Error('Missing Finance approval.');let sent=0;const queued=run.rows.filter(row=>row.status==='queued').slice(0,20);if(MailApp.getRemainingDailyQuota()<queued.length)throw Error('Not enough remaining daily mail quota. No emails were sent.');
 for(const row of queued){
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(row.email)){row.status='review_required';row.error='Invalid email';continue;}
  row.status='sending';row.attemptAt=new Date().toISOString();writeState_(s); // Durable before mail: an uncertain send must not auto-retry.
  try{const parts=hrPayParts(row);const html='<html><body style="font-family:Arial;padding:30px"><h1>'+hrEscape(s.settings.company)+'</h1><h2>Payslip — '+hrEscape(run.month)+'</h2><p>'+hrEscape(row.name)+' · '+hrEscape(row.employeeId)+'</p><table style="width:100%">'+[['Basic',parts.basic],['Allowances',parts.allowance],['Bonus',parts.bonus],['Deductions',parts.deduction],['Net',parts.net]].map(r=>'<tr><td style="padding:10px;border-bottom:1px solid #ddd">'+r[0]+'</td><td>'+hrEscape(r[1])+' '+hrEscape(s.settings.currency)+'</td></tr>').join('')+'</table><p>Payroll approved by Finance. This document is not proof of bank transfer.</p></body></html>';
   const pdf=Utilities.newBlob(html,'text/html').getAs(MimeType.PDF).setName('payslip-'+run.month+'-'+row.employeeId+'.pdf');const file=DriveApp.getFolderById(props_().getProperty('DRIVE_FOLDER_ID')).createFile(pdf);row.pdfFileId=file.getId(); // Private, no public link or sharing grant.
   MailApp.sendEmail({to:row.email,subject:s.settings.company+' | Payslip '+run.month,body:'Hello '+row.name+',\nYour approved payslip for '+run.month+' is attached. Please contact HR if any detail needs review.',attachments:[pdf],name:s.settings.company+' HR'});row.status='sent';row.sentAt=new Date().toISOString();sent++;writeState_(s);
  }catch(err){row.status='review_required';row.error=String(err).slice(0,300);writeState_(s);}
 }
 run.status=run.rows.every(r=>r.status==='sent')?'sent':'approved';s.audit.unshift({id:'A-'+Date.now(),at:new Date().toISOString(),actor,action:'payroll.send: '+run.month+' ('+sent+' sent)'});s.revision++;return{message:sent+' payslips sent. Pending rows: '+run.rows.filter(r=>r.status!=='sent').length+'. Review sending/review_required rows manually before any retry.'};
}

function setSchedule_(enabled){ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='payrollTick').forEach(t=>ScriptApp.deleteTrigger(t));if(enabled)ScriptApp.newTrigger('payrollTick').timeBased().everyDays(1).atHour(9).inTimezone('Africa/Cairo').create();props_().setProperty('AUTO_SEND',enabled?'true':'false');}
function uploadDocument_(s,p,a){
 if(!['admin','hr'].includes(a.role)&&p.employeeId!==a.employeeId)throw Error('Only the employee or HR can upload this document.');
 const e=s.employees.find(e=>e.id===p.employeeId);if(!e||e.status==='inactive')throw Error('Active employee required.');if(!s.settings.requiredDocuments.includes(p.type))throw Error('Unknown document requirement.');
 if(!['application/pdf','image/png','image/jpeg'].includes(p.mime)||typeof p.base64!=='string'||p.base64.length>2800000)throw Error('Only PDF, PNG, JPEG up to 2 MB.');
 const bytes=Utilities.base64Decode(p.base64);if(bytes.length>2097152||!bytes.length)throw Error('File size must be below 2 MB.');const signature=bytes.slice(0,8).map(v=>v&255);const valid=p.mime==='application/pdf'&&signature.slice(0,4).join(',')==='37,80,68,70'||p.mime==='image/png'&&signature.join(',')==='137,80,78,71,13,10,26,10'||p.mime==='image/jpeg'&&signature[0]===255&&signature[1]===216;if(!valid)throw Error('File content does not match its declared type.');
 if(p.expiresAt)hrDate(p.expiresAt);const root=DriveApp.getFolderById(props_().getProperty('DRIVE_FOLDER_ID'));let archive;const archiveId=props_().getProperty('DOCUMENT_ARCHIVE_ID');if(archiveId)archive=DriveApp.getFolderById(archiveId);else{archive=root.createFolder('Employment Documents • مسوغات التعيين');props_().setProperty('DOCUMENT_ARCHIVE_ID',archive.getId());}
 const folders=archive.getFoldersByName(e.id);const employeeFolder=folders.hasNext()?folders.next():archive.createFolder(e.id);const name=String(p.name||'document').replace(/[\/\\]/g,'_').slice(0,180);const file=employeeFolder.createFile(Utilities.newBlob(bytes,p.mime,Date.now()+'-'+name)); // Never grant public or staff-wide sharing.
 hrMutate(s,'document.register',{employeeId:e.id,type:p.type,name,mime:p.mime,size:bytes.length,fileId:file.getId(),expiresAt:p.expiresAt||''},{...a,demo:true});
}
function getDocument_(s,id,a){const d=(s.documents||[]).find(d=>d.id===id);if(!d||!(['admin','hr'].includes(a.role)||d.employeeId===a.employeeId))throw Error('Document access denied.');const blob=DriveApp.getFileById(d.fileId).getBlob();return{name:d.name,mime:d.mime,base64:Utilities.base64Encode(blob.getBytes())};}
